{
  "name": "changesignal",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11.7.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "test": "vitest run",
    "e2e": "node scripts/run-e2e.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings 0",
    "secret:audit": "node scripts/secret-audit.mjs",
    "release:audit": "node scripts/audit-release.mjs",
    "standalone:smoke": "node scripts/smoke-standalone.mjs",
    "verify:artifacts": "node scripts/verify-evidence.mjs && pnpm bright:audit evidence/live-run-recovered.json && pnpm bright:audit evidence/next-live-api-run.json",
    "verify": "pnpm audit --prod && pnpm test && pnpm typecheck && pnpm lint && pnpm build && pnpm release:audit && pnpm standalone:smoke && pnpm e2e && pnpm verify:artifacts && pnpm secret:audit",
    "bright:login": "bdata login",
    "bright:create": "bash scripts/brightdata.sh create",
    "bright:run": "bash scripts/brightdata.sh run",
    "bright:heal": "bash scripts/brightdata.sh heal",
    "bright:audit": "node scripts/audit-live-run.mjs"
  },
  "dependencies": {
    "@brightdata/cli": "0.3.6",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
