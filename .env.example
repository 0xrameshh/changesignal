# Checked-in artifacts work without credentials. These values enable fresh server-side runs.
BRIGHTDATA_COLLECTOR_ID=c_replace_with_live_collector
BRIGHTDATA_API_KEY=replace_with_bright_data_api_key
BRIGHTDATA_TARGET_URL=https://bun.sh/blog

# Required for browser-triggered live operations on a public server (minimum 16 characters).
CHANGESIGNAL_OPERATOR_KEY=replace_with_a_random_operator_key
# Keep browser-triggered healing off unless reviewed operation is intentional.
CHANGESIGNAL_ALLOW_WEB_HEAL=false
# Development-only escape hatch; ignored when NODE_ENV=production.
CHANGESIGNAL_ALLOW_UNAUTHENTICATED_LIVE_ACTIONS=false
CHANGESIGNAL_RELEASE=local

# Safe default. Change to live only when intentionally showing the recovered snapshot or enabling live controls.
NEXT_PUBLIC_ARTIFACT_MODE=fixture
